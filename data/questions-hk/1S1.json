      "type": "choice",
      "difficulty": "advanced",
      "prompt": "圓柱和球都可以滾動。以下哪一句對？",
      "choices": [
        {
          "key": "A",
          "text": "兩者都只有曲面"
        },
        {
          "key": "B",
          "text": "圓柱有兩個平面，球沒有平面"
        },
        {
          "key": "C",
          "text": "球有兩個平面"
        },
        {
          "key": "D",
          "text": "兩者都不能堆疊"
        }
      ],
      "answer": "B",
      "explanation": "圓柱兩端是兩個平面（圓形），中間是曲面；球整個表面都是曲面，沒有平面。"
    },
    {
      "id": "cnm_p014_q4",
      "topicId": "cnm_p014",
      "type": "choice",
      "difficulty": "advanced",
      "prompt": "把兩個正方體疊起來，為甚麼可以疊得穩？",
      "choices": [
        {
          "key": "A",
          "text": "因為它們有平平的面"
        },
        {
          "key": "B",
          "text": "因為它們會滾動"
        },
        {
          "key": "C",
          "text": "因為它們是圓的"
        },
        {
          "key": "D",
          "text": "因為它們很輕"
        }
      ],
      "answer": "A",
      "explanation": "正方體有平平的面，平面與平面貼合就能疊穩。會滾的球和圓柱就疊不穩。"
    }
